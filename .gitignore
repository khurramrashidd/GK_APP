# ============================================================
# Firebase config — PUBLIC REPO: keep real keys out of git history.
# Commit lib/firebase_options.dart.example instead (see README).
# Not strictly required (Firebase API keys aren't secret — your Firestore
# Security Rules are the real protection), but kept out of an easily
# browsable public repo as a precaution.
# ============================================================
lib/firebase_options.dart
google-services.json
GoogleService-Info.plist
